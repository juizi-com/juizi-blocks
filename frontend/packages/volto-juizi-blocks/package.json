{
  "name": "volto-juizi-blocks",
  "version": "1.0.0-beta.2",
  "description": "Consolidated Juizi block set for Volto, with a central colour dashboard and per-block toggles. Works with or without Volto Light Theme, and adds its theme support when the site switches it on.",
  "main": "src/index.ts",
  "license": "MIT",
  "keywords": [
    "volto-addon",
    "volto",
    "plone",
    "react"
  ],
  "author": "Juizi",
  "homepage": "https://github.com/juizi-com/juizi-blocks#readme",
  "repository": {
    "type": "git",
    "url": "git@github.com:juizi-com/juizi-blocks"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "i18n": "rm -rf build/messages && NODE_ENV=production i18n --addon",
    "dry-release": "release-it --dry-run",
    "release": "release-it",
    "release-major-alpha": "release-it major --preRelease=alpha",
    "release-alpha": "release-it --preRelease=alpha"
  },
  "addons": [
    "@kitconcept/volto-bm3-compat"
  ],
  "dependencies": {
    "@kitconcept/volto-bm3-compat": "^1.0.0-alpha.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.48.0"
  },
  "peerDependencies": {
    "classnames": "^2.2.6",
    "lodash": "^4.17.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-intl": "^3.12.1",
    "react-redux": "8.1.2",
    "react-router-dom": "^5.2.0",
    "react-toastify": "^5.4.1",
    "semantic-ui-react": "^2.1.5"
  },
  "devDependencies": {
    "@plone/registry": "workspace:*",
    "@plone/scripts": "workspace:*",
    "@plone/types": "workspace:*",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "release-it": "^19.0.5",
    "react-redux": "8.1.2"
  }
}
