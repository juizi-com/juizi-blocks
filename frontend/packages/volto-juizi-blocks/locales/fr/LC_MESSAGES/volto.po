msgid "juizi-gallery-source"
msgstr "Origine des images"

#. Default: "Pictures inside this page"
#: components/Blocks/EmblaGallery/messages
msgid "juizi-gallery-source-context"
msgstr "Images de cette page"

#. Default: "'Pictures inside this page' shows the pictures stored in this page. 'Pictures from across the site' finds them using rules you set."
#: components/Blocks/EmblaGallery/messages
msgid "juizi-gallery-source-help"
msgstr "« Images de cette page » affiche les images rangées dans cette page. « Images de tout le site » les trouve à l’aide des règles que vous définissez."

#. Default: "Pictures from across the site"
#: components/Blocks/EmblaGallery/messages
msgid "juizi-gallery-source-query"
msgstr "Images de tout le site"

#. Default: "pictures in neat rows, all cropped to the same size"
#: components/Blocks/EmblaGallery/messages
msgid "juizi-gallery-start-even"
msgstr "des images en rangées régulières, toutes recadrées à la même taille"

#. Default: "pictures keep their own shape and fit together in columns"
#: components/Blocks/EmblaGallery/messages
msgid "juizi-gallery-start-natural"
msgstr "les images gardent leur forme d’origine et s’assemblent en colonnes"

#. Default: "one large picture at a time, with small pictures underneath to click through"
#: components/Blocks/EmblaGallery/messages
msgid "juizi-gallery-start-slideshow"
msgstr "une grande image à la fois, avec de petites images en dessous pour passer de l’une à l’autre"

#. Default: "Changing style may affect how the pictures are presented."
#: components/Blocks/EmblaGallery/messages
msgid "juizi-gallery-style-change-help"
msgstr "Changer de style peut modifier la présentation des images."

#. Default: "Large picture with small pictures below"
#: components/Blocks/EmblaGallery/messages
msgid "juizi-gallery-style-featured"
msgstr "Grande image avec de petites images en dessous"

#. Default: "Row of small pictures only"
#: components/Blocks/EmblaGallery/messages
msgid "juizi-gallery-style-strip"
msgstr "Rangée de petites images uniquement"

#. Default: "Size of the small pictures"
