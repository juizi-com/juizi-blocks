msgstr "Bouton"

#. Default: "{color} — Outlined"
#: components/Blocks/_shared/messages
msgid "juizi-button-outlined"
msgstr "{color} — Contour"

#. Default: "{color} — Solid"
#: components/Blocks/_shared/messages
msgid "juizi-button-solid"
msgstr "{color} — Plein"

#. Default: "Button style"
#: components/Blocks/_shared/messages
msgid "juizi-button-style"
msgstr "Style du bouton"

#. Default: "Button text"
#: components/Blocks/_shared/messages
msgid "juizi-button-text"
msgstr "Texte du bouton"

#. Default: "Buttons"
#: components/Blocks/_shared/messages
msgid "juizi-buttons"
msgstr "Boutons"

#. Default: "Text colour follows the background automatically."
#: components/Blocks/Callout/messages
msgid "juizi-callout-background-help"
msgstr "La couleur du texte s’adapte automatiquement à l’arrière-plan."

#. Default: "What this callout is for. Changing it updates the icon and colours, except ones you've changed yourself."
#: components/Blocks/Callout/messages
msgid "juizi-callout-change-type"
msgstr "À quoi sert cet encadré. Le modifier met à jour l’icône et les couleurs, sauf celles que vous avez changées vous-même."

#. Default: "Choose a callout type to get started."
#: components/Blocks/Callout/messages
msgid "juizi-callout-choose-type"
msgstr "Choisissez un type d’encadré pour commencer."

#. Default: "Colours"
#: components/Blocks/Callout/messages
msgid "juizi-callout-colors"
msgstr "Couleurs"

#. Default: "Add a title and text in the sidebar."
#: components/Blocks/Callout/messages
msgid "juizi-callout-empty"
msgstr "Ajoutez un titre et un texte dans la barre latérale."

#. Default: "Warning"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-alert-triangle"
msgstr "Avertissement"

#. Default: "Award"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-award"
msgstr "Récompense"

#. Default: "Read"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-book-open"
msgstr "Lecture"

#. Default: "Calendar"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-calendar"
msgstr "Calendrier"

#. Default: "Success"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-check-circle"
msgstr "Succès"

#. Default: "Time"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-clock"
msgstr "Heure"

#. Default: "Icon colour"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-color"
msgstr "Couleur de l’icône"

#. Default: "The icon colour is hard to see on this background. Choose a lighter or darker one under Colours."
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-contrast"
msgstr "La couleur de l’icône se voit mal sur cet arrière-plan. Choisissez-en une plus claire ou plus sombre sous Couleurs."

#. Default: "Download"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-download"
msgstr "Téléchargement"

#. Default: "Heart"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-heart"
msgstr "Cœur"

#. Default: "Info"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-info"
msgstr "Info"

#. Default: "Idea"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-lightbulb"
msgstr "Idée"

#. Default: "Email"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-mail"
msgstr "E-mail"

#. Default: "Location"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-map-pin"
msgstr "Lieu"

#. Default: "Announcement"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-megaphone"
msgstr "Annonce"

#. Default: "Phone"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-phone"
msgstr "Téléphone"

#. Default: "Launch"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-rocket"
msgstr "Lancement"

#. Default: "Secure"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-shield-check"
msgstr "Sécurisé"

#. Default: "Highlight"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-sparkles"
msgstr "Mise en avant"

#. Default: "Star"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-star"
msgstr "Étoile"

#. Default: "People"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-users"
msgstr "Personnes"

#. Default: "Fast"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-zap"
msgstr "Rapide"

#. Default: "Link colour"
#: components/Blocks/Callout/messages
msgid "juizi-callout-link-color"
msgstr "Couleur du lien"

#. Default: "The link colour is hard to see on this background. Choose a lighter or darker one under Colours."
#: components/Blocks/Callout/messages
msgid "juizi-callout-link-contrast"
msgstr "La couleur du lien se voit mal sur cet arrière-plan. Choisissez-en une plus claire ou plus sombre sous Couleurs."

#. Default: "Same as text"
#: components/Blocks/Callout/messages
msgid "juizi-callout-same-as-text"
msgstr "Identique au texte"

#. Default: "Select a callout type in the sidebar to get started."
#: components/Blocks/Callout/messages
msgid "juizi-callout-select-type"
msgstr "Sélectionnez un type d’encadré dans la barre latérale pour commencer."

#. Default: "Callout type"
#: components/Blocks/Callout/messages
msgid "juizi-callout-type"
msgstr "Type d’encadré"

#. Default: "Announcement"
#: components/Blocks/Callout/messages
msgid "juizi-callout-type-announcement"
msgstr "Annonce"

#. Default: "news, an update or a call to action"
#: components/Blocks/Callout/messages
msgid "juizi-callout-type-announcement-help"
msgstr "une actualité, une mise à jour ou un appel à l’action"

#. Default: "Information"
#: components/Blocks/Callout/messages
msgid "juizi-callout-type-info"
msgstr "Information"

#. Default: "neutral background information or context"
#: components/Blocks/Callout/messages
msgid "juizi-callout-type-info-help"
msgstr "information ou contexte neutre"

#. Default: "Success"
#: components/Blocks/Callout/messages
msgid "juizi-callout-type-success"
msgstr "Succès"

#. Default: "a positive outcome, confirmation or achievement"
#: components/Blocks/Callout/messages
msgid "juizi-callout-type-success-help"
msgstr "un résultat positif, une confirmation ou une réussite"

#. Default: "Tip"
#: components/Blocks/Callout/messages
msgid "juizi-callout-type-tip"
msgstr "Conseil"

#. Default: "a helpful suggestion or good practice"
#: components/Blocks/Callout/messages
msgid "juizi-callout-type-tip-help"
msgstr "une suggestion utile ou une bonne pratique"

#. Default: "Warning"
#: components/Blocks/Callout/messages
msgid "juizi-callout-type-warning"
msgstr "Avertissement"

#. Default: "something the reader needs to be careful about"
#: components/Blocks/Callout/messages
msgid "juizi-callout-type-warning-help"
msgstr "un point auquel le lecteur doit faire attention"

#. Default: "Add a picture to this slide in the sidebar."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-add-picture"
msgstr "Ajoutez une image à cette diapositive dans la barre latérale."

#. Default: "Add the review text and the name in the sidebar."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-add-review"
msgstr "Ajoutez le texte de l’avis et le nom dans la barre latérale."

#. Default: "Also show slides I add myself"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-append-manual"
msgstr "Afficher aussi les diapositives que j’ajoute moi-même"

#. Default: "Your own slides come after the pages found."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-append-manual-help"
msgstr "Vos propres diapositives viennent après les pages trouvées."

#. Default: "On phones the arrows always sit below the carousel, whatever you choose here, so they are easy to reach with a thumb."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-arrow-position-help"
msgstr "Sur téléphone, les flèches sont toujours placées sous le carrousel, quel que soit votre choix ici, afin d’être faciles à atteindre avec le pouce."

#. Default: "Standard: dark round arrows on the sides, outlined arrows above or below. Or pick a colour to match your buttons."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-arrow-style-help"
msgstr "Standard : flèches rondes sombres sur les côtés, flèches en contour au-dessus ou en dessous. Ou choisissez une couleur assortie à vos boutons."

#. Default: "On each side of the carousel"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-arrows-sides"
msgstr "De chaque côté du carrousel"

#. Default: "Top right, beside the heading"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-arrows-top"
msgstr "En haut à droite, à côté du titre"

#. Default: "Solid fill for the block. Text colour follows it automatically. If a background image is also set, the image is shown on top of this colour."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-background-color-help"
msgstr "Couleur unie pour le bloc. La couleur du texte s’y adapte automatiquement. Si une image d’arrière-plan est aussi définie, elle s’affiche par-dessus cette couleur."

#. Default: "Optional image behind the whole block. Displayed at full cover, no overlay. Decorative: screen readers skip it."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-background-image-help"
msgstr "Image facultative derrière tout le bloc. Affichée en couverture complète, sans voile. Décorative : les lecteurs d’écran l’ignorent."

#. Default: "Scrolling & behaviour"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-behaviour"
msgstr "Défilement et comportement"

#. Default: "Below the carousel"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-below-carousel"
msgstr "Sous le carrousel"

#. Default: "Show arrow on button"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-button-arrow"
msgstr "Afficher une flèche sur le bouton"

#. Default: "Adds a right arrow to this slide's button"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-button-arrow-help"
msgstr "Ajoute une flèche vers la droite au bouton de cette diapositive"

#. Default: "Card layout"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-card-layout"
msgstr "Disposition des cartes"

#. Default: "Make entire card clickable"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-clickable"
msgstr "Rendre toute la carte cliquable"

#. Default: "Clicking anywhere on the card follows the slide link. The slide heading is used as the link text for screen readers — add a heading to every slide when this is on."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-clickable-help"
msgstr "Un clic n’importe où sur la carte suit le lien de la diapositive. Le titre de la diapositive sert de texte de lien pour les lecteurs d’écran : ajoutez un titre à chaque diapositive lorsque cette option est activée."

#. Default: "Make entire review clickable"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-clickable-reviews"
msgstr "Rendre tout l’avis cliquable"

#. Default: "Clicking anywhere on a review follows its link. Only reviews with both a link and a name become clickable."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-clickable-reviews-help"
msgstr "Un clic n’importe où sur un avis suit son lien. Seuls les avis qui ont à la fois un lien et un nom deviennent cliquables."

#. Default: "Don't show a date"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-date-none"
msgstr "Ne pas afficher de date"

#. Default: "Publication date"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-date-publication"
msgstr "Date de publication"

#. Default: "Event start date (falls back to publication date)"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-date-start"
msgstr "Date de début de l’événement (à défaut, date de publication)"

#. Default: "No slides yet. Add slides in the sidebar under Slides, or switch on 'Fill automatically from site content' to fill it automatically."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-empty-manual"
msgstr "Aucune diapositive pour l’instant. Ajoutez-en dans la barre latérale, sous Diapositives, ou activez « Remplir automatiquement à partir du contenu du site »."

#. Default: "Your content query found nothing to show. Change its criteria in the sidebar."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-empty-query"
msgstr "Votre recherche de contenu n’a rien trouvé à afficher. Modifiez ses critères dans la barre latérale."

#. Default: "No reviews yet. Add reviews in the sidebar under Reviews."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-empty-reviews"
msgstr "Aucun avis pour l’instant. Ajoutez-en dans la barre latérale, sous Avis."

#. Default: "Equal height cards"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-equal-height"
msgstr "Cartes de même hauteur"

#. Default: "Stretches all cards to match the tallest one in the row"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-equal-height-help"
msgstr "Étire toutes les cartes à la hauteur de la plus grande de la rangée"

#. Default: "Equal height reviews"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-equal-height-reviews"
msgstr "Avis de même hauteur"

#. Default: "Stretches all reviews to match the tallest one in the row"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-equal-height-reviews-help"
msgstr "Étire tous les avis à la hauteur du plus grand de la rangée"

#. Default: "Fast"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-fast"
msgstr "Rapide"

#. Default: "Filter content"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-filter-label"
msgstr "Filtrer le contenu"

#. Default: "Filter buttons by tag"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-filter-tags"
msgstr "Boutons de filtre par étiquette"

#. Default: "Tags, separated by commas, e.g. News, Events. Each tag becomes a button above the carousel, plus 'All'. Uses the tags set on each page."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-filter-tags-help"
msgstr "Étiquettes séparées par des virgules, par ex. Actualités, Événements. Chaque étiquette devient un bouton au-dessus du carrousel, en plus de « Tout ». Utilise les étiquettes définies sur chaque page."

#. Default: "Optional heading shown above the carousel. Screen readers use it to name this section, so even a short heading helps."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-heading-help"
msgstr "Titre facultatif affiché au-dessus du carrousel. Les lecteurs d’écran l’utilisent pour nommer cette section : même un titre court est utile."

#. Default: "Hide \"Read more\" buttons"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-hide-buttons"
msgstr "Masquer les boutons « Lire la suite »"

#. Default: "Hide description"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-hide-description"
msgstr "Masquer la description"

#. Default: "Hide dots"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-hide-dots"
msgstr "Masquer les points"

#. Default: "Hide image"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-hide-image"
msgstr "Masquer l’image"

#. Default: "Hides each card's image in the 'Image above content' layout, even when a slide has one set"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-hide-image-help"
msgstr "Masque l’image de chaque carte dans la disposition « Image au-dessus du contenu », même si une diapositive en a une"

#. Default: "Optional text shown below the heading, above the carousel"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-intro-help"
msgstr "Texte facultatif affiché sous le titre, au-dessus du carrousel"

#. Default: "On large screens"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-large-screens"
msgstr "Sur grand écran"

#. Default: "Show arrow on buttons"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-listing-arrow"
msgstr "Afficher une flèche sur les boutons"

#. Default: "Adds a right arrow to the 'Read more' button on every found page"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-listing-arrow-help"
msgstr "Ajoute une flèche vers la droite au bouton « Lire la suite » de chaque page trouvée"

#. Default: "Button style for found pages"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-listing-button-style"
msgstr "Style du bouton des pages trouvées"

#. Default: "Style for the 'Read more' button on each found page"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-listing-button-style-help"
msgstr "Style du bouton « Lire la suite » de chaque page trouvée"

#. Default: "Label for the 'Read more' button on each found page"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-listing-button-text-help"
msgstr "Libellé du bouton « Lire la suite » de chaque page trouvée"

#. Default: "Logo alignment"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-logo-alignment"
msgstr "Alignement des logos"

#. Default: "Where the logos sit when they all fit across. Once there are more than fit, they scroll."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-logo-alignment-help"
msgstr "Emplacement des logos lorsqu’ils tiennent tous sur la largeur. Dès qu’il y en a davantage, ils défilent."

#. Default: "Logo"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-logo-alt"
msgstr "Logo"

#. Default: "Space between logos"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-logo-gap"
msgstr "Espace entre les logos"

#. Default: "Space around each logo"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-logo-padding"
msgstr "Espace autour de chaque logo"

#. Default: "Logo size"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-logo-size"
msgstr "Taille des logos"

#. Default: "Logo strip"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-logo-strip"
msgstr "Bandeau de logos"

#. Default: "All the logos fit across, so the strip stays still. It scrolls once there are more logos than fit."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-logos-fit"
msgstr "Tous les logos tiennent sur la largeur : le bandeau reste donc immobile. Il défile dès qu’il y a plus de logos que la largeur ne peut en contenir."

#. Default: "Image with text overlay"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-mode-full"
msgstr "Image avec le texte par-dessus"

#. Default: "Image only"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-mode-image-only"
msgstr "Image seule"

#. Default: "Image above content"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-mode-image-top"
msgstr "Image au-dessus du contenu"

#. Default: "Scrolling logo strip"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-mode-logo"
msgstr "Bandeau de logos défilant"

#. Default: "Reviews"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-mode-reviews"
msgstr "Avis"

#. Default: "\"More\" button alignment"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-more-button-align"
msgstr "Alignement du bouton « Plus »"

#. Default: "Horizontal alignment when the button sits below the carousel dots"
