#. Default: "Callout"
#: blocks/messages
msgid "Callout"
msgstr "Encadré"

#. Default: "Carousel"
#: blocks/messages
msgid "Carousel"
msgstr "Carrousel"

#. Default: "Content Row"
#: blocks/messages
msgid "Content Row"
msgstr "Rangée de contenu"

#. Default: "Gallery"
#: blocks/messages
msgid "Gallery"
msgstr "Galerie"

#. Default: "Hero"
#: blocks/messages
msgid "Hero"
msgstr "Hero"

#. Default: "Highlighted message with an icon and an optional link."
#: blocks/messages
msgid "Highlighted message with an icon and an optional link."
msgstr "Message mis en avant avec une icône et un lien facultatif."

#. Default: "Page header or themed section band with title, background image or video, and buttons."
#: blocks/messages
msgid "Page header or themed section band with title, background image or video, and buttons."
msgstr "En-tête de page ou bande de section colorée avec titre, image ou vidéo d’arrière-plan et boutons."

#. Default: "Pictures from the page or across the site, as a slideshow, even grid or natural grid, with an optional enlarged view."
#: blocks/messages
msgid "Pictures from the page or across the site, as a slideshow, even grid or natural grid, with an optional enlarged view."
msgstr "Images de la page ou de tout le site, en diaporama, en grille régulière ou en grille naturelle, avec une vue agrandie facultative."

#. Default: "Redirect"
#: blocks/messages
msgid "Redirect"
msgstr "Redirection"

#. Default: "Row of numbered steps, icons, statistics or image cards, with optional mobile carousel."
#: blocks/messages
msgid "Row of numbered steps, icons, statistics or image cards, with optional mobile carousel."
msgstr "Rangée d’étapes numérotées, d’icônes, de statistiques ou de cartes avec image, avec carrousel facultatif sur mobile."

#. Default: "Sends anonymous visitors to another page or URL. Editors are not redirected."
#: blocks/messages
msgid "Sends anonymous visitors to another page or URL. Editors are not redirected."
msgstr "Envoie les visiteurs anonymes vers une autre page ou URL. Les rédacteurs ne sont pas redirigés."

#. Default: "Slides you add or pages found automatically, shown as a carousel, card row, reviews or scrolling logo strip."
#: blocks/messages
msgid "Slides you add or pages found automatically, shown as a carousel, card row, reviews or scrolling logo strip."
msgstr "Diapositives que vous ajoutez ou pages trouvées automatiquement, affichées en carrousel, en rangée de cartes, en avis ou en bandeau de logos défilant."

