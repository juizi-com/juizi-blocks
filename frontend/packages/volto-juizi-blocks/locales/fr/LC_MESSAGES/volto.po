#: components/Blocks/EmblaGallery/messages
msgid "juizi-gallery-row-alignment-help"
msgstr "Emplacement de la rangée de petites images lorsqu’elles tiennent toutes sur la largeur. Dès qu’il y en a davantage, elles défilent à partir de la gauche."

#. Default: "Slideshow behaviour"
#: components/Blocks/EmblaGallery/messages
msgid "juizi-gallery-slideshow-behaviour"
msgstr "Comportement du diaporama"

#. Default: "Slideshow style"
#: components/Blocks/EmblaGallery/messages
msgid "juizi-gallery-slideshow-style"
msgstr "Style du diaporama"

#. Default: "Where the pictures come from"
