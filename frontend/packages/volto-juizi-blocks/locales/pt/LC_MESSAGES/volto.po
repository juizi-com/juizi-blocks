msgstr "De onde vêm as imagens"

#. Default: "Pictures inside this page"
#: components/Blocks/EmblaGallery/messages
msgid "juizi-gallery-source-context"
msgstr "Imagens dentro desta página"

#. Default: "'Pictures inside this page' shows the pictures stored in this page. 'Pictures from across the site' finds them using rules you set."
#: components/Blocks/EmblaGallery/messages
msgid "juizi-gallery-source-help"
msgstr "“Imagens dentro desta página” mostra as imagens guardadas nesta página. “Imagens de todo o site” encontra-as com as regras que definir."

#. Default: "Pictures from across the site"
