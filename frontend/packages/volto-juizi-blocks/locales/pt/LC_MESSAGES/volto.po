msgstr "Acima do conteúdo"

#. Default: "Above title"
#: components/Blocks/HeroBlock/messages
msgid "juizi-hero-above-title"
msgstr "Acima do título"

#. Default: "Add a heading in the sidebar."
#: components/Blocks/HeroBlock/messages
msgid "juizi-hero-add-heading"
msgstr "Adicione um título na barra lateral."

#. Default: "Alt text"
#: components/Blocks/HeroBlock/messages
msgid "juizi-hero-alt-text"
msgstr "Texto alternativo"

#. Default: "Describes the image for screen reader users. Leave empty only if the image is purely decorative and adds no information beyond the text."
#: components/Blocks/HeroBlock/messages
msgid "juizi-hero-alt-text-help"
msgstr "Descreve a imagem para quem usa leitores de ecrã. Deixe vazio apenas se a imagem for puramente decorativa e não acrescentar informação ao texto."

#. Default: "Sets the block background. Text colour updates automatically based on your choice."
#: components/Blocks/HeroBlock/messages
msgid "juizi-hero-background-color-help"
msgstr "Define o fundo do bloco. A cor do texto atualiza-se automaticamente conforme a sua escolha."

