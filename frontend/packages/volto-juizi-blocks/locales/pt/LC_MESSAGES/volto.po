#. Default: "A sound recording with a player, title, description and transcript."
#: blocks/messages
msgid "A sound recording with a player, title, description and transcript."
msgstr "Uma gravação de áudio com leitor, título, descrição e transcrição."

#. Default: "Audio"
#: blocks/messages
msgid "Audio"
msgstr "Áudio"

#. Default: "Callout"
#: blocks/messages
msgid "Callout"
msgstr "Destaque"

#. Default: "Carousel"
#: blocks/messages
msgid "Carousel"
msgstr "Carrossel"

#. Default: "Content Row"
#: blocks/messages
msgid "Content Row"
msgstr "Linha de conteúdo"

#. Default: "Gallery"
#: blocks/messages
msgid "Gallery"
msgstr "Galeria"

#. Default: "Hero"
#: blocks/messages
msgid "Hero"
msgstr "Hero"

#. Default: "Highlighted message with an icon and an optional link."
#: blocks/messages
msgid "Highlighted message with an icon and an optional link."
msgstr "Mensagem em destaque com um ícone e um link opcional."

#. Default: "Page header or themed section band with title, background image or video, and buttons."
#: blocks/messages
msgid "Page header or themed section band with title, background image or video, and buttons."
msgstr "Cabeçalho de página ou faixa de secção com cor, com título, imagem ou vídeo de fundo e botões."

#. Default: "Pictures from the page or across the site, as a slideshow, even grid or natural grid, with an optional enlarged view."
#: blocks/messages
msgid "Pictures from the page or across the site, as a slideshow, even grid or natural grid, with an optional enlarged view."
msgstr "Imagens da página ou de todo o site, como apresentação de imagens, grelha regular ou grelha natural, com vista ampliada opcional."

#. Default: "Redirect"
#: blocks/messages
msgid "Redirect"
msgstr "Redirecionamento"

#. Default: "Row of numbered steps, icons, statistics or image cards, with optional mobile carousel."
#: blocks/messages
msgid "Row of numbered steps, icons, statistics or image cards, with optional mobile carousel."
msgstr "Linha de passos numerados, ícones, estatísticas ou cartões com imagem, com carrossel opcional em dispositivos móveis."

#. Default: "Sends anonymous visitors to another page or URL. Editors are not redirected."
#: blocks/messages
msgid "Sends anonymous visitors to another page or URL. Editors are not redirected."
msgstr "Envia os visitantes anónimos para outra página ou URL. Os editores não são redirecionados."

#. Default: "Slides you add or pages found automatically, shown as a carousel, card row, reviews or scrolling logo strip."
#: blocks/messages
msgid "Slides you add or pages found automatically, shown as a carousel, card row, reviews or scrolling logo strip."
msgstr "Diapositivos que adicionar ou páginas encontradas automaticamente, apresentados como carrossel, fila de cartões, avaliações ou faixa de logótipos em movimento."

#. Default: "Add a label"
#: components/Blocks/_shared/messages
msgid "juizi-add-label"
msgstr "Adicione uma etiqueta"

#. Default: "Add a link"
#: components/Blocks/_shared/messages
msgid "juizi-add-link"
msgstr "Adicione um link"

#. Default: "Advanced"
#: components/Blocks/_shared/messages
msgid "juizi-advanced"
msgstr "Avançado"

#. Default: "All"
#: components/Blocks/_shared/messages
msgid "juizi-all"
msgstr "Tudo"

#. Default: "Appearance"
#: components/Blocks/_shared/messages
msgid "juizi-appearance"
msgstr "Aspeto"

#. Default: "Arrow position"
#: components/Blocks/_shared/messages
msgid "juizi-arrow-position"
msgstr "Posição das setas"

#. Default: "Arrow style"
#: components/Blocks/_shared/messages
msgid "juizi-arrow-style"
msgstr "Estilo das setas"

#. Default: "Optional: add a transcript in the sidebar, so visitors who can’t hear the recording can read it."
#: components/Blocks/Audio/messages
msgid "juizi-audio-add-transcript"
msgstr "Opcional: adicione uma transcrição na barra lateral, para que os visitantes que não conseguem ouvir a gravação a possam ler."

#. Default: "The title and text colour follow the background automatically."
#: components/Blocks/Audio/messages
msgid "juizi-audio-background-help"
msgstr "A cor do título e do texto acompanha automaticamente o fundo."

#. Default: "This file can’t be played. Check that it’s an audio file (such as an MP3), or choose a different one under “Audio file” in the sidebar."
#: components/Blocks/Audio/messages
msgid "juizi-audio-cannot-play"
msgstr "Não é possível reproduzir este ficheiro. Verifique se é um ficheiro de áudio (como um MP3) ou escolha outro em “Ficheiro de áudio” na barra lateral."

#. Default: "Colours"
#: components/Blocks/Audio/messages
msgid "juizi-audio-colors"
msgstr "Cores"

#. Default: "Description"
#: components/Blocks/Audio/messages
msgid "juizi-audio-description"
msgstr "Descrição"

#. Default: "A sentence or two about what visitors will hear, shown above the player."
#: components/Blocks/Audio/messages
msgid "juizi-audio-description-help"
msgstr "Uma ou duas frases sobre o que os visitantes vão ouvir, apresentadas por cima do leitor."

#. Default: "Download the audio file"
#: components/Blocks/Audio/messages
msgid "juizi-audio-download"
msgstr "Descarregar o ficheiro de áudio"

#. Default: "Audio file"
#: components/Blocks/Audio/messages
msgid "juizi-audio-file"
msgstr "Ficheiro de áudio"

#. Default: "Choose an audio file on this site, or paste the web address of one (for example an MP3). If the file isn’t on the site yet, upload it first: save this page, add it as a File with the Add (+) button in the toolbar, then come back and choose it here."
#: components/Blocks/Audio/messages
msgid "juizi-audio-file-help"
msgstr "Escolha um ficheiro de áudio deste site ou cole o endereço web de um (por exemplo, um MP3). Se o ficheiro ainda não estiver no site, carregue-o primeiro: guarde esta página, adicione-o como ficheiro com o botão Adicionar (+) na barra de ferramentas e depois volte para o escolher aqui."

#. Default: "Your browser can’t play this audio."
#: components/Blocks/Audio/messages
msgid "juizi-audio-no-player"
msgstr "O seu navegador não consegue reproduzir este áudio."

#. Default: "Audio"
#: components/Blocks/Audio/messages
msgid "juizi-audio-player-label"
msgstr "Áudio"

#. Default: "Read the transcript"
#: components/Blocks/Audio/messages
msgid "juizi-audio-show-transcript"
msgstr "Ler a transcrição"

#. Default: "Link to an audio file under “Audio file” in the sidebar. No audio file on the site yet? Upload it first: save this page, add it as a File with the Add (+) button in the toolbar, then come back and choose it."
#: components/Blocks/Audio/messages
msgid "juizi-audio-start"
msgstr "Associe um ficheiro de áudio em “Ficheiro de áudio”, na barra lateral. Ainda não há nenhum ficheiro de áudio no site? Carregue-o primeiro: guarde esta página, adicione-o como ficheiro com o botão Adicionar (+) na barra de ferramentas e depois volte para o escolher."

#. Default: "Shown above the player, and read out by screen readers as the player’s name."
#: components/Blocks/Audio/messages
msgid "juizi-audio-title-help"
msgstr "Aparece por cima do leitor e é lido pelos leitores de ecrã como o nome do leitor."

#. Default: "Transcript"
#: components/Blocks/Audio/messages
msgid "juizi-audio-transcript"
msgstr "Transcrição"

#. Default: "The words spoken in the recording. Visitors who can’t hear it can open and read it under the player."
#: components/Blocks/Audio/messages
msgid "juizi-audio-transcript-help"
msgstr "As palavras ditas na gravação. Os visitantes que não a conseguem ouvir podem abri-la e lê-la por baixo do leitor."

#. Default: "Autoplay"
#: components/Blocks/_shared/messages
msgid "juizi-autoplay"
msgstr "Reprodução automática"

#. Default: "Automatically turned off for visitors who have asked their device to reduce motion."
#: components/Blocks/_shared/messages
msgid "juizi-autoplay-reduced-motion"
msgstr "Desativada automaticamente para os visitantes que pediram ao seu dispositivo para reduzir o movimento."

#. Default: "Background"
#: components/Blocks/_shared/messages
msgid "juizi-background"
msgstr "Fundo"

#. Default: "Background colour"
#: components/Blocks/_shared/messages
msgid "juizi-background-color"
msgstr "Cor de fundo"

#. Default: "Background image"
#: components/Blocks/_shared/messages
msgid "juizi-background-image"
msgstr "Imagem de fundo"

#. Default: "This block couldn't be displayed. Try undoing your last change or checking its settings in the sidebar. If it keeps happening, contact your web team."
#: components/Blocks/_shared/messages
msgid "juizi-block-error"
msgstr "Não foi possível apresentar este bloco. Tente anular a sua última alteração ou verificar as definições do bloco na barra lateral. Se o problema continuar, fale com a sua equipa web."

#. Default: "Bottom"
#: components/Blocks/_shared/messages
msgid "juizi-bottom"
msgstr "Fundo"

#. Default: "Bottom padding"
#: components/Blocks/_shared/messages
msgid "juizi-bottom-padding"
msgstr "Espaçamento inferior"

#. Default: "Breadcrumb"
#: components/Blocks/_shared/messages
msgid "juizi-breadcrumb"
msgstr "Caminho de navegação"

#. Default: "Button"
#: components/Blocks/_shared/messages
msgid "juizi-button"
msgstr "Botão"

#. Default: "{color} — Outlined"
#: components/Blocks/_shared/messages
msgid "juizi-button-outlined"
msgstr "{color} — Contorno"

#. Default: "{color} — Solid"
#: components/Blocks/_shared/messages
msgid "juizi-button-solid"
msgstr "{color} — Preenchido"

#. Default: "Button style"
#: components/Blocks/_shared/messages
msgid "juizi-button-style"
msgstr "Estilo do botão"

#. Default: "Button text"
#: components/Blocks/_shared/messages
msgid "juizi-button-text"
msgstr "Texto do botão"

#. Default: "Buttons"
#: components/Blocks/_shared/messages
msgid "juizi-buttons"
msgstr "Botões"

#. Default: "Text colour follows the background automatically."
#: components/Blocks/Callout/messages
msgid "juizi-callout-background-help"
msgstr "A cor do texto acompanha automaticamente o fundo."

#. Default: "What this callout is for. Changing it updates the icon and colours, except ones you've changed yourself."
#: components/Blocks/Callout/messages
msgid "juizi-callout-change-type"
msgstr "Para que serve este destaque. Alterá-lo atualiza o ícone e as cores, exceto os que já tiver alterado."

#. Default: "Choose a callout type to get started."
#: components/Blocks/Callout/messages
msgid "juizi-callout-choose-type"
msgstr "Escolha um tipo de destaque para começar."

#. Default: "Colours"
#: components/Blocks/Callout/messages
msgid "juizi-callout-colors"
msgstr "Cores"

#. Default: "Add a title and text in the sidebar."
#: components/Blocks/Callout/messages
msgid "juizi-callout-empty"
msgstr "Adicione um título e texto na barra lateral."

