#. Default: "Callout"
#: blocks/messages
msgid "Callout"
msgstr "Uitligblok"

#. Default: "Carousel"
#: blocks/messages
msgid "Carousel"
msgstr "Karrousel"

#. Default: "Content Row"
#: blocks/messages
msgid "Content Row"
msgstr "Inhoudry"

#. Default: "Gallery"
#: blocks/messages
msgid "Gallery"
msgstr "Galery"

#. Default: "Hero"
#: blocks/messages
msgid "Hero"
msgstr "Hero"

#. Default: "Highlighted message with an icon and an optional link."
#: blocks/messages
msgid "Highlighted message with an icon and an optional link."
msgstr "Uitgeligte boodskap met ’n ikoon en ’n opsionele skakel."

#. Default: "Page header or themed section band with title, background image or video, and buttons."
#: blocks/messages
msgid "Page header or themed section band with title, background image or video, and buttons."
msgstr "Bladsyopskrif of gekleurde afdelingsband met titel, agtergrondbeeld of -video, en knoppies."

#. Default: "Pictures from the page or across the site, as a slideshow, even grid or natural grid, with an optional enlarged view."
#: blocks/messages
msgid "Pictures from the page or across the site, as a slideshow, even grid or natural grid, with an optional enlarged view."
msgstr "Prente van die bladsy of van oor die hele werf, as ’n skyfievertoning, egalige rooster of natuurlike rooster, met ’n opsionele vergrote aansig."

#. Default: "Redirect"
#: blocks/messages
msgid "Redirect"
msgstr "Herleiding"

#. Default: "Row of numbered steps, icons, statistics or image cards, with optional mobile carousel."
#: blocks/messages
msgid "Row of numbered steps, icons, statistics or image cards, with optional mobile carousel."
msgstr "Ry genommerde stappe, ikone, statistieke of beeldkaarte, met opsionele karrousel op selfone."

#. Default: "Sends anonymous visitors to another page or URL. Editors are not redirected."
#: blocks/messages
msgid "Sends anonymous visitors to another page or URL. Editors are not redirected."
msgstr "Stuur anonieme besoekers na ’n ander bladsy of URL. Redakteurs word nie herlei nie."

#. Default: "Slides you add or pages found automatically, shown as a carousel, card row, reviews or scrolling logo strip."
#: blocks/messages
msgid "Slides you add or pages found automatically, shown as a carousel, card row, reviews or scrolling logo strip."
msgstr "Skyfies wat jy byvoeg of bladsye wat outomaties gevind word, gewys as ’n karrousel, kaartry, resensies of rollende logostrook."

#. Default: "Add a label"
#: components/Blocks/_shared/messages
msgid "juizi-add-label"
msgstr "Voeg ’n etiket by"

