#. Default: "Choose where to send visitors in the sidebar, under 'Send visitors to'."
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-choose-prompt"
msgstr "Kies in die sybalk waarheen om besoekers te stuur, onder “Stuur besoekers na”."

#. Default: "Go now"
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-go-now"
msgstr "Gaan nou"

#. Default: "Go to {name} now"
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-go-to"
msgstr "Gaan nou na {name}"

#. Default: "Go to the page now"
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-go-to-page"
msgstr "Gaan nou na die bladsy"

#. Default: "This redirect has no destination yet, so visitors stay on this page. Edit the page to choose one."
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-no-destination"
msgstr "Hierdie herleiding het nog geen bestemming nie, so besoekers bly op hierdie bladsy. Redigeer die bladsy om een te kies."

#. Default: "Page name"
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-page-name"
msgstr "Bladsynaam"

#. Default: "Shown instead of the web address, e.g. 'Our new events page'. Leave empty to show the address."
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-page-name-help"
msgstr "Word in plaas van die webadres gewys, bv. “Ons nuwe geleentheidsbladsy”. Laat leeg om die adres te wys."

#. Default: "Search engines keep listing this page. To move a page for good, ask your site administrator to set up a permanent redirect."
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-permanent-hint"
msgstr "Soekenjins hou aan om hierdie bladsy te lys. Om ’n bladsy permanent te skuif, vra jou werfadministrateur om ’n permanente herleiding op te stel."

#. Default: "Redirecting in {seconds}…"
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-redirecting"
msgstr "Herlei oor {seconds}…"

#. Default: "Redirecting…"
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-redirecting-now"
msgstr "Herlei tans…"

#. Default: "This points to the page you're editing, so visitors would go round in circles. Choose a different page in the sidebar."
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-same-page-edit"
msgstr "Dit wys na die bladsy wat jy redigeer, so besoekers sou in sirkels loop. Kies ’n ander bladsy in die sybalk."

#. Default: "This redirect points to this same page, so visitors aren't sent anywhere. Edit the page to choose a different one."
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-same-page-view"
msgstr "Hierdie herleiding wys na hierdie selfde bladsy, so besoekers word nêrens heen gestuur nie. Redigeer die bladsy om ’n ander een te kies."

#. Default: "Send visitors to"
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-send-to"
msgstr "Stuur besoekers na"

#. Default: "Choose a page on this site, or type a web address. Visitors see this page for a few seconds, then move on. You and other editors aren't redirected."
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-send-to-help"
msgstr "Kies ’n bladsy op hierdie werf, of tik ’n webadres. Besoekers sien hierdie bladsy vir ’n paar sekondes en gaan dan verder. Jy en ander redakteurs word nie herlei nie."

