#. Default: "Callout"
#: blocks/messages
msgid "Callout"
msgstr "Destacado"

#. Default: "Carousel"
#: blocks/messages
msgid "Carousel"
msgstr "Carrusel"

#. Default: "Content Row"
#: blocks/messages
msgid "Content Row"
msgstr "Fila de contenido"

#. Default: "Gallery"
#: blocks/messages
msgid "Gallery"
msgstr "Galería"

#. Default: "Hero"
#: blocks/messages
msgid "Hero"
msgstr "Hero"

#. Default: "Highlighted message with an icon and an optional link."
#: blocks/messages
msgid "Highlighted message with an icon and an optional link."
msgstr "Mensaje destacado con un icono y un enlace opcional."

#. Default: "Page header or themed section band with title, background image or video, and buttons."
#: blocks/messages
msgid "Page header or themed section band with title, background image or video, and buttons."
msgstr "Encabezado de página o franja de sección con color, con título, imagen o vídeo de fondo y botones."

#. Default: "Pictures from the page or across the site, as a slideshow, even grid or natural grid, with an optional enlarged view."
#: blocks/messages
msgid "Pictures from the page or across the site, as a slideshow, even grid or natural grid, with an optional enlarged view."
msgstr "Imágenes de la página o de todo el sitio, como pase de imágenes, cuadrícula uniforme o cuadrícula natural, con vista ampliada opcional."

#. Default: "Redirect"
#: blocks/messages
msgid "Redirect"
msgstr "Redirección"

#. Default: "Row of numbered steps, icons, statistics or image cards, with optional mobile carousel."
#: blocks/messages
msgid "Row of numbered steps, icons, statistics or image cards, with optional mobile carousel."
msgstr "Fila de pasos numerados, iconos, estadísticas o tarjetas con imagen, con carrusel opcional en móviles."

#. Default: "Sends anonymous visitors to another page or URL. Editors are not redirected."
#: blocks/messages
msgid "Sends anonymous visitors to another page or URL. Editors are not redirected."
msgstr "Envía a los visitantes anónimos a otra página o URL. Los editores no son redirigidos."

#. Default: "Slides you add or pages found automatically, shown as a carousel, card row or scrolling logo strip."
#: blocks/messages
msgid "Slides you add or pages found automatically, shown as a carousel, card row or scrolling logo strip."
msgstr "Diapositivas que añada o páginas encontradas automáticamente, mostradas como carrusel, fila de tarjetas o franja de logotipos en movimiento."

#. Default: "Add a label"
#: components/Blocks/_shared/messages
msgid "juizi-add-label"
msgstr "Añada una etiqueta"

#. Default: "Add a link"
#: components/Blocks/_shared/messages
msgid "juizi-add-link"
msgstr "Añada un enlace"

#. Default: "Advanced"
#: components/Blocks/_shared/messages
msgid "juizi-advanced"
msgstr "Avanzado"

#. Default: "All"
#: components/Blocks/_shared/messages
msgid "juizi-all"
msgstr "Todo"

#. Default: "Appearance"
#: components/Blocks/_shared/messages
msgid "juizi-appearance"
msgstr "Apariencia"

#. Default: "Arrow position"
#: components/Blocks/_shared/messages
msgid "juizi-arrow-position"
msgstr "Posición de las flechas"

#. Default: "Arrow style"
#: components/Blocks/_shared/messages
msgid "juizi-arrow-style"
msgstr "Estilo de las flechas"

#. Default: "Autoplay"
#: components/Blocks/_shared/messages
msgid "juizi-autoplay"
msgstr "Reproducción automática"

#. Default: "Automatically turned off for visitors who have asked their device to reduce motion."
#: components/Blocks/_shared/messages
msgid "juizi-autoplay-reduced-motion"
msgstr "Se desactiva automáticamente para los visitantes que han pedido a su dispositivo que reduzca el movimiento."

#. Default: "Background"
#: components/Blocks/_shared/messages
msgid "juizi-background"
msgstr "Fondo"

#. Default: "Background colour"
#: components/Blocks/_shared/messages
msgid "juizi-background-color"
msgstr "Color de fondo"

#. Default: "Background image"
#: components/Blocks/_shared/messages
msgid "juizi-background-image"
msgstr "Imagen de fondo"

#. Default: "This block couldn't be displayed. Try undoing your last change or checking its settings in the sidebar. If it keeps happening, contact your web team."
#: components/Blocks/_shared/messages
msgid "juizi-block-error"
msgstr "No se ha podido mostrar este bloque. Pruebe a deshacer su último cambio o revise sus ajustes en la barra lateral. Si sigue ocurriendo, póngase en contacto con su equipo web."

#. Default: "Bottom"
#: components/Blocks/_shared/messages
msgid "juizi-bottom"
msgstr "Abajo"

#. Default: "Bottom padding"
#: components/Blocks/_shared/messages
msgid "juizi-bottom-padding"
msgstr "Espaciado inferior"

#. Default: "Breadcrumb"
#: components/Blocks/_shared/messages
msgid "juizi-breadcrumb"
msgstr "Ruta de navegación"

#. Default: "Button"
#: components/Blocks/_shared/messages
msgid "juizi-button"
msgstr "Botón"

#. Default: "{color} — Outlined"
#: components/Blocks/_shared/messages
msgid "juizi-button-outlined"
msgstr "{color} — Contorno"

#. Default: "{color} — Solid"
#: components/Blocks/_shared/messages
msgid "juizi-button-solid"
msgstr "{color} — Relleno"

#. Default: "Button style"
#: components/Blocks/_shared/messages
msgid "juizi-button-style"
msgstr "Estilo del botón"

#. Default: "Button text"
#: components/Blocks/_shared/messages
msgid "juizi-button-text"
msgstr "Texto del botón"

#. Default: "Buttons"
#: components/Blocks/_shared/messages
msgid "juizi-buttons"
msgstr "Botones"

#. Default: "Text colour follows the background automatically."
#: components/Blocks/Callout/messages
msgid "juizi-callout-background-help"
msgstr "El color del texto sigue automáticamente al fondo."

#. Default: "What this callout is for. Changing it updates the icon and colours, except ones you've changed yourself."
#: components/Blocks/Callout/messages
msgid "juizi-callout-change-type"
msgstr "Para qué sirve este destacado. Al cambiarlo se actualizan el icono y los colores, salvo los que haya cambiado usted."

#. Default: "Choose a callout type to get started."
#: components/Blocks/Callout/messages
msgid "juizi-callout-choose-type"
msgstr "Elija un tipo de destacado para empezar."

#. Default: "Colours"
#: components/Blocks/Callout/messages
msgid "juizi-callout-colors"
msgstr "Colores"

#. Default: "Add a title and text in the sidebar."
#: components/Blocks/Callout/messages
msgid "juizi-callout-empty"
msgstr "Añada un título y un texto en la barra lateral."

#. Default: "Warning"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-alert-triangle"
msgstr "Advertencia"

#. Default: "Award"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-award"
msgstr "Premio"

#. Default: "Read"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-book-open"
msgstr "Lectura"

#. Default: "Calendar"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-calendar"
msgstr "Calendario"

#. Default: "Success"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-check-circle"
msgstr "Éxito"

#. Default: "Time"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-clock"
msgstr "Hora"

#. Default: "Icon colour"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-color"
msgstr "Color del icono"

#. Default: "The icon colour is hard to see on this background. Choose a lighter or darker one under Colours."
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-contrast"
msgstr "El color del icono se ve mal sobre este fondo. Elija uno más claro o más oscuro en Colores."

#. Default: "Download"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-download"
msgstr "Descarga"

#. Default: "Heart"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-heart"
msgstr "Corazón"

#. Default: "Info"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-info"
msgstr "Información"

#. Default: "Idea"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-lightbulb"
msgstr "Idea"

#. Default: "Email"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-mail"
msgstr "Correo electrónico"

#. Default: "Location"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-map-pin"
msgstr "Ubicación"

#. Default: "Announcement"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-megaphone"
msgstr "Anuncio"

#. Default: "Phone"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-phone"
msgstr "Teléfono"

#. Default: "Launch"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-rocket"
msgstr "Lanzamiento"

#. Default: "Secure"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-shield-check"
msgstr "Seguro"

#. Default: "Highlight"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-sparkles"
msgstr "Destacado"

#. Default: "Star"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-star"
msgstr "Estrella"

#. Default: "People"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-users"
msgstr "Personas"

#. Default: "Fast"
#: components/Blocks/Callout/messages
msgid "juizi-callout-icon-zap"
msgstr "Rápido"

#. Default: "Link colour"
#: components/Blocks/Callout/messages
msgid "juizi-callout-link-color"
msgstr "Color del enlace"

#. Default: "The link colour is hard to see on this background. Choose a lighter or darker one under Colours."
#: components/Blocks/Callout/messages
msgid "juizi-callout-link-contrast"
msgstr "El color del enlace se ve mal sobre este fondo. Elija uno más claro o más oscuro en Colores."

#. Default: "Same as text"
#: components/Blocks/Callout/messages
msgid "juizi-callout-same-as-text"
msgstr "Igual que el texto"

#. Default: "Select a callout type in the sidebar to get started."
#: components/Blocks/Callout/messages
msgid "juizi-callout-select-type"
msgstr "Seleccione un tipo de destacado en la barra lateral para empezar."

#. Default: "Callout type"
#: components/Blocks/Callout/messages
msgid "juizi-callout-type"
msgstr "Tipo de destacado"

#. Default: "Announcement"
#: components/Blocks/Callout/messages
msgid "juizi-callout-type-announcement"
msgstr "Anuncio"

#. Default: "news, an update or a call to action"
#: components/Blocks/Callout/messages
msgid "juizi-callout-type-announcement-help"
msgstr "una noticia, una novedad o una llamada a la acción"

#. Default: "Information"
#: components/Blocks/Callout/messages
msgid "juizi-callout-type-info"
msgstr "Información"

#. Default: "neutral background information or context"
#: components/Blocks/Callout/messages
msgid "juizi-callout-type-info-help"
msgstr "información de contexto neutral"

#. Default: "Success"
#: components/Blocks/Callout/messages
msgid "juizi-callout-type-success"
msgstr "Éxito"

#. Default: "a positive outcome, confirmation or achievement"
#: components/Blocks/Callout/messages
msgid "juizi-callout-type-success-help"
msgstr "un resultado positivo, una confirmación o un logro"

#. Default: "Tip"
#: components/Blocks/Callout/messages
msgid "juizi-callout-type-tip"
msgstr "Consejo"

#. Default: "a helpful suggestion or good practice"
#: components/Blocks/Callout/messages
msgid "juizi-callout-type-tip-help"
msgstr "una sugerencia útil o buena práctica"

#. Default: "Warning"
#: components/Blocks/Callout/messages
msgid "juizi-callout-type-warning"
msgstr "Advertencia"

#. Default: "something the reader needs to be careful about"
#: components/Blocks/Callout/messages
msgid "juizi-callout-type-warning-help"
msgstr "algo con lo que el lector debe tener cuidado"

#. Default: "Add a picture to this slide in the sidebar."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-add-picture"
msgstr "Añada una imagen a esta diapositiva en la barra lateral."

#. Default: "Also show slides I add myself"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-append-manual"
msgstr "Mostrar también las diapositivas que añada yo"

#. Default: "Your own slides come after the pages found."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-append-manual-help"
msgstr "Sus propias diapositivas van después de las páginas encontradas."

#. Default: "On phones the arrows always sit below the carousel, whatever you choose here, so they are easy to reach with a thumb."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-arrow-position-help"
msgstr "En los móviles, las flechas siempre se sitúan debajo del carrusel, elija lo que elija aquí, para que sea fácil alcanzarlas con el pulgar."

#. Default: "Standard: dark round arrows on the sides, outlined arrows above or below. Or pick a colour to match your buttons."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-arrow-style-help"
msgstr "Estándar: flechas redondas oscuras a los lados, flechas con contorno arriba o abajo. O elija un color a juego con sus botones."

#. Default: "On each side of the carousel"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-arrows-sides"
msgstr "A cada lado del carrusel"

#. Default: "Top right, beside the heading"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-arrows-top"
msgstr "Arriba a la derecha, junto al encabezado"

#. Default: "Solid fill for the block. Text colour follows it automatically. If a background image is also set, the image is shown on top of this colour."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-background-color-help"
msgstr "Color sólido para el bloque. El color del texto lo sigue automáticamente. Si además hay una imagen de fondo, la imagen se muestra encima de este color."

#. Default: "Optional image behind the whole block. Displayed at full cover, no overlay. Decorative: screen readers skip it."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-background-image-help"
msgstr "Imagen opcional detrás de todo el bloque. Se muestra cubriéndolo todo, sin superposición. Decorativa: los lectores de pantalla la omiten."

#. Default: "Scrolling & behaviour"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-behaviour"
msgstr "Desplazamiento y comportamiento"

#. Default: "Below the carousel"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-below-carousel"
msgstr "Debajo del carrusel"

#. Default: "Show arrow on button"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-button-arrow"
msgstr "Mostrar flecha en el botón"

#. Default: "Adds a right arrow to this slide's button"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-button-arrow-help"
msgstr "Añade una flecha hacia la derecha al botón de esta diapositiva"

#. Default: "Card layout"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-card-layout"
msgstr "Diseño de las tarjetas"

#. Default: "Make entire card clickable"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-clickable"
msgstr "Hacer que toda la tarjeta se pueda pulsar"

#. Default: "Clicking anywhere on the card follows the slide link. The slide heading is used as the link text for screen readers — add a heading to every slide when this is on."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-clickable-help"
msgstr "Al pulsar en cualquier punto de la tarjeta se sigue el enlace de la diapositiva. El encabezado de la diapositiva se usa como texto del enlace para los lectores de pantalla: añada un encabezado a cada diapositiva cuando esta opción esté activada."

#. Default: "Don't show a date"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-date-none"
msgstr "No mostrar fecha"

#. Default: "Publication date"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-date-publication"
msgstr "Fecha de publicación"

#. Default: "Event start date (falls back to publication date)"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-date-start"
msgstr "Fecha de inicio del evento (o, en su defecto, fecha de publicación)"

#. Default: "No slides yet. Add slides in the sidebar under Slides, or switch on 'Fill automatically from site content' to fill it automatically."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-empty-manual"
msgstr "Aún no hay diapositivas. Añádalas en la barra lateral, en Diapositivas, o active “Rellenar automáticamente con contenido del sitio”."

#. Default: "Your content query found nothing to show. Change its criteria in the sidebar."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-empty-query"
msgstr "La búsqueda de contenido no ha encontrado nada que mostrar. Cambie sus criterios en la barra lateral."

#. Default: "Equal height cards"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-equal-height"
msgstr "Tarjetas de igual altura"

#. Default: "Stretches all cards to match the tallest one in the row"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-equal-height-help"
msgstr "Estira todas las tarjetas hasta la altura de la más alta de la fila"

#. Default: "Fast"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-fast"
msgstr "Rápida"

#. Default: "Filter content"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-filter-label"
msgstr "Filtrar contenido"

#. Default: "Filter buttons by tag"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-filter-tags"
msgstr "Botones de filtro por etiqueta"

#. Default: "Tags, separated by commas, e.g. News, Events. Each tag becomes a button above the carousel, plus 'All'. Uses the tags set on each page."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-filter-tags-help"
msgstr "Etiquetas separadas por comas, p. ej. Noticias, Eventos. Cada etiqueta se convierte en un botón encima del carrusel, además de “Todo”. Usa las etiquetas definidas en cada página."

#. Default: "Optional heading shown above the carousel. Screen readers use it to name this section, so even a short heading helps."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-heading-help"
msgstr "Encabezado opcional que se muestra encima del carrusel. Los lectores de pantalla lo usan para nombrar esta sección, así que incluso un encabezado breve ayuda."

#. Default: "Hide \"Read more\" buttons"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-hide-buttons"
msgstr "Ocultar los botones “Leer más”"

#. Default: "Hide description"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-hide-description"
msgstr "Ocultar descripción"

#. Default: "Hide dots"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-hide-dots"
msgstr "Ocultar puntos"

#. Default: "Hide image"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-hide-image"
msgstr "Ocultar imagen"

#. Default: "Hides each card's image in the 'Image above content' layout, even when a slide has one set"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-hide-image-help"
msgstr "Oculta la imagen de cada tarjeta en el diseño “Imagen encima del contenido”, aunque la diapositiva tenga una"

#. Default: "Optional text shown below the heading, above the carousel"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-intro-help"
msgstr "Texto opcional que se muestra debajo del encabezado, encima del carrusel"

#. Default: "On large screens"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-large-screens"
msgstr "En pantallas grandes"

#. Default: "Show arrow on buttons"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-listing-arrow"
msgstr "Mostrar flecha en los botones"

#. Default: "Adds a right arrow to the 'Read more' button on every found page"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-listing-arrow-help"
msgstr "Añade una flecha hacia la derecha al botón “Leer más” de cada página encontrada"

#. Default: "Button style for found pages"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-listing-button-style"
msgstr "Estilo del botón de las páginas encontradas"

#. Default: "Style for the 'Read more' button on each found page"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-listing-button-style-help"
msgstr "Estilo del botón “Leer más” de cada página encontrada"

#. Default: "Label for the 'Read more' button on each found page"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-listing-button-text-help"
msgstr "Etiqueta del botón “Leer más” de cada página encontrada"

#. Default: "Logo alignment"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-logo-alignment"
msgstr "Alineación de los logotipos"

#. Default: "Where the logos sit when they all fit across. Once there are more than fit, they scroll."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-logo-alignment-help"
msgstr "Dónde se sitúan los logotipos cuando caben todos a lo ancho. Cuando hay más de los que caben, se desplazan."

#. Default: "Logo"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-logo-alt"
msgstr "Logotipo"

#. Default: "Space between logos"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-logo-gap"
msgstr "Espacio entre logotipos"

#. Default: "Space around each logo"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-logo-padding"
msgstr "Espacio alrededor de cada logotipo"

#. Default: "Logo size"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-logo-size"
msgstr "Tamaño de los logotipos"

#. Default: "Logo strip"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-logo-strip"
msgstr "Franja de logotipos"

#. Default: "All the logos fit across, so the strip stays still. It scrolls once there are more logos than fit."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-logos-fit"
msgstr "Todos los logotipos caben a lo ancho, así que la franja se queda quieta. Se desplaza cuando hay más logotipos de los que caben."

#. Default: "Image with text overlay"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-mode-full"
msgstr "Imagen con el texto encima"

#. Default: "Image only"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-mode-image-only"
msgstr "Solo imagen"

#. Default: "Image above content"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-mode-image-top"
msgstr "Imagen encima del contenido"

#. Default: "Scrolling logo strip"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-mode-logo"
msgstr "Franja de logotipos en movimiento"

#. Default: "\"More\" button alignment"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-more-button-align"
msgstr "Alineación del botón “Más”"

#. Default: "Horizontal alignment when the button sits below the carousel dots"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-more-button-align-help"
msgstr "Alineación horizontal cuando el botón se sitúa debajo de los puntos del carrusel"

#. Default: "\"More\" button link"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-more-button-link"
msgstr "Enlace del botón “Más”"

#. Default: "\"More\" button position"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-more-button-position"
msgstr "Posición del botón “Más”"

#. Default: "Where the optional \"More\" button appears. Independent of the arrow position."
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-more-button-position-help"
msgstr "Dónde aparece el botón opcional “Más”. Es independiente de la posición de las flechas."

#. Default: "\"More\" button style"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-more-button-style"
msgstr "Estilo del botón “Más”"

#. Default: "\"More\" button text"
#: components/Blocks/EmblaCarousel/messages
msgid "juizi-carousel-more-button-text"
msgstr "Texto del botón “Más”"

#. Default: "Optional button, e.g. \"All news\". Placed using \"More\" button position above."
#: components/Blocks/EmblaCarousel/messages
