msgstr "{count, plural, one {# segundo} other {# segundos}}"

#. Default: "Select a display style in the sidebar to get started."
#: components/Blocks/_shared/messages
msgid "juizi-select-style-prompt"
msgstr "Seleccione un estilo de presentación en la barra lateral para empezar."

#. Default: "Slide navigation"
#: components/Blocks/_shared/messages
