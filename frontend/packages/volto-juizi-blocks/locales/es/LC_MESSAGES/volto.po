#: components/Blocks/Redirect/messages
msgid "juizi-redirect-no-destination"
msgstr "Esta redirección aún no tiene destino, así que los visitantes se quedan en esta página. Edite la página para elegir uno."

#. Default: "Page name"
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-page-name"
msgstr "Nombre de la página"

#. Default: "Shown instead of the web address, e.g. 'Our new events page'. Leave empty to show the address."
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-page-name-help"
msgstr "Se muestra en lugar de la dirección web, p. ej. “Nuestra nueva página de eventos”. Déjelo vacío para mostrar la dirección."

#. Default: "Search engines keep listing this page. To move a page for good, ask your site administrator to set up a permanent redirect."
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-permanent-hint"
msgstr "Los buscadores siguen mostrando esta página. Para mover una página de forma definitiva, pida al administrador del sitio que configure una redirección permanente."

#. Default: "Redirecting in {seconds}…"
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-redirecting"
msgstr "Redirigiendo en {seconds}…"

#. Default: "Redirecting…"
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-redirecting-now"
msgstr "Redirigiendo…"

#. Default: "This points to the page you're editing, so visitors would go round in circles. Choose a different page in the sidebar."
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-same-page-edit"
msgstr "Esto apunta a la misma página que está editando, así que los visitantes darían vueltas en círculo. Elija otra página en la barra lateral."

#. Default: "This redirect points to this same page, so visitors aren't sent anywhere. Edit the page to choose a different one."
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-same-page-view"
msgstr "Esta redirección apunta a esta misma página, así que los visitantes no son enviados a ningún sitio. Edite la página para elegir otra."

#. Default: "Send visitors to"
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-send-to"
msgstr "Enviar a los visitantes a"

#. Default: "Choose a page on this site, or type a web address. Visitors see this page for a few seconds, then move on. You and other editors aren't redirected."
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-send-to-help"
msgstr "Elija una página de este sitio o escriba una dirección web. Los visitantes ven esta página unos segundos y luego continúan. Usted y los demás editores no son redirigidos."

#. Default: "Taking you to {name} in {seconds}…"
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-taking"
msgstr "Le llevamos a {name} en {seconds}…"

#. Default: "Taking you to {name}…"
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-taking-now"
msgstr "Le llevamos a {name}…"

#. Default: "Visitors will be sent to {destination}"
#: components/Blocks/Redirect/messages
msgid "juizi-redirect-will-be-sent"
msgstr "Los visitantes serán enviados a {destination}"

#. Default: "Right"
#: components/Blocks/_shared/messages
msgid "juizi-right"
msgstr "Derecha"

#. Default: "{count, plural, one {# second} other {# seconds}}"
