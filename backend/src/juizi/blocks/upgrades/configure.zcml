<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    >

  <!-- Example upgrade step
  <genericsetup:upgradeSteps
      profile="juizi.blocks:default"
      source="1000"
      destination="1001"
      >
    <genericsetup:upgradeDepends
        title="Update registry value"
        import_steps="plone.app.registry"
        />
  </genericsetup:upgradeSteps>
  -->

  <genericsetup:upgradeSteps
      profile="juizi.blocks:default"
      source="1000"
      destination="1001"
      >
    <genericsetup:upgradeDepends
        title="Add the juizi.blocks.enabled_blocks registry record"
        import_steps="plone.app.registry"
        />
  </genericsetup:upgradeSteps>

  <genericsetup:upgradeSteps
      profile="juizi.blocks:default"
      source="1001"
      destination="1002"
      >
    <genericsetup:upgradeDepends
        title="Add the juizi.blocks.block_groups registry record"
        import_steps="plone.app.registry"
        />
  </genericsetup:upgradeSteps>

  <genericsetup:upgradeSteps
      profile="juizi.blocks:default"
      source="1002"
      destination="1003"
      >
    <genericsetup:upgradeDepends
        title="Add the juizi.blocks.editor_language registry record"
        import_steps="plone.app.registry"
        />
  </genericsetup:upgradeSteps>

  <genericsetup:upgradeSteps
      profile="juizi.blocks:default"
      source="1003"
      destination="1004"
      >
    <genericsetup:upgradeDepends
        title="Add the juizi.blocks.print_config registry record"
        import_steps="plone.app.registry"
        />
  </genericsetup:upgradeSteps>

  <genericsetup:upgradeSteps
      profile="juizi.blocks:default"
      source="1004"
      destination="1005"
      >
    <genericsetup:upgradeDepends
        title="Add the Events calendar's catalog index and column"
        import_steps="catalog"
        />
    <genericsetup:upgradeStep
        title="Add 'Calendar entry only' to events and index them, where the calendar is switched on"
        handler="juizi.blocks.calendar.setup.install"
        />
  </genericsetup:upgradeSteps>

  <genericsetup:upgradeSteps
      profile="juizi.blocks:default"
      source="1005"
      destination="1006"
      >
    <genericsetup:upgradeDepends
        title="Add the juizi.blocks.calendar_config registry record"
        import_steps="plone.app.registry"
        />
    <genericsetup:upgradeStep
        title="Let tech event slots appear in calendars, where the calendar is switched on"
        handler="juizi.blocks.calendar.setup.install"
        />
  </genericsetup:upgradeSteps>

  <!-- -*- extra stuff goes here -*- -->

</configure>
