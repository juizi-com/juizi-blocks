<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="juizi.blocks"
    >

  <genericsetup:registerProfile
      name="default"
      title="Juizi Blocks"
      description="Juizi's block set (Hero, Content Row, Carousel, Gallery, Callout, Redirect) with a dashboard for colours and block switches. Needs the volto-juizi-blocks frontend add-on."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      />

  <genericsetup:registerProfile
      name="devsite"
      title="Juizi Blocks: Development site"
      description="Set up this add-on's own development site: Volto Light Theme, its site settings, and the site title and email sender name"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/devsite"
      />

  <genericsetup:registerProfile
      name="initial"
      title="Juizi Blocks: Example content"
      description="Create example content to showcase the new website"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/initial"
      pre_handler=".setuphandlers.initial.create_example_content"
      post_handler=".setuphandlers.initial.create_language_demo"
      />

  <!-- Hide Uninstall Profile-->
  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="juizi.blocks"
      />


  <include package=".upgrades" />

</configure>
